// Cube pixel shader (Diligent HLSL) - test/cube, diffuse + ambient lighting

struct PSInput
{
    float4 Position : SV_POSITION;
    float3 WorldNormal : TEXCOORD0;
    float3 WorldLightDir : TEXCOORD1;
};

float4 main(in PSInput PSIn) : SV_TARGET
{
    float3 N = normalize(PSIn.WorldNormal);
    float3 L = normalize(PSIn.WorldLightDir);
    float NdotL = max(dot(N, L), 0.0);

    float3 ambient = float3(0.15, 0.15, 0.2);
    float3 diffuseColor = float3(0.25, 0.7, 0.35);
    float3 lightColor = float3(1.0, 0.95, 0.9);

    float3 diffuse = diffuseColor * lightColor * NdotL;
    float3 color = ambient * diffuseColor + diffuse;

    return float4(color, 1.0);
}
