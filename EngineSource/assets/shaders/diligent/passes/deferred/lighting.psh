// Diligent HLSL: passes/deferred/lighting (same logic as opengl passes/deferred/lighting.frag)
struct PSInput
{
    float4 Position : SV_POSITION;
    float2 TexCoord : TEXCOORD0;
};

#define MAX_POINT_LIGHTS 8
#define MAX_SPOT_LIGHTS 4

cbuffer Constants : register(b0)
{
    float3 u_ViewPos;
    float _pad0;
    float3 u_LightDir;
    float _pad1;
    float3 u_LightColor;
    float u_LightIntensity;
    float3 u_Ambient;
    float u_Exposure;
    row_major float4x4 u_LightSpaceMatrix;
    float u_ShadowBias;
    int u_UseShadows;
    int u_PointLightCount;
    int u_SpotLightCount;
    int _pad2;
    float3 u_PointLightPos[MAX_POINT_LIGHTS];
    float3 u_PointLightColor[MAX_POINT_LIGHTS];
    float u_PointLightIntensity[MAX_POINT_LIGHTS];
    float u_PointLightRadius[MAX_POINT_LIGHTS];
    float3 u_SpotLightPos[MAX_SPOT_LIGHTS];
    float3 u_SpotLightDir[MAX_SPOT_LIGHTS];
    float3 u_SpotLightColor[MAX_SPOT_LIGHTS];
    float u_SpotLightIntensity[MAX_SPOT_LIGHTS];
    float u_SpotLightRange[MAX_SPOT_LIGHTS];
    float u_SpotLightInnerCos[MAX_SPOT_LIGHTS];
    float u_SpotLightOuterCos[MAX_SPOT_LIGHTS];
};

Texture2D u_Position : register(t0);
Texture2D u_Normal : register(t1);
Texture2D u_Albedo : register(t2);
Texture2D u_PBR : register(t3);
Texture2D u_ShadowMap : register(t5);
SamplerState u_LinearSampler : register(s0);
SamplerState u_ShadowSampler : register(s5);

float shadowFactor(float3 worldPos)
{
    if (u_UseShadows <= 0) return 0.0;
    float4 lightSpacePos = mul(u_LightSpaceMatrix, float4(worldPos, 1.0));
    float3 ndc = lightSpacePos.xyz / lightSpacePos.w;
    ndc = ndc * 0.5 + 0.5;
    if (ndc.z > 1.0 || ndc.x < 0.0 || ndc.x > 1.0 || ndc.y < 0.0 || ndc.y > 1.0)
        return 0.0;
    float depth = u_ShadowMap.Sample(u_ShadowSampler, ndc.xy).r;
    return (ndc.z - u_ShadowBias > depth) ? 1.0 : 0.0;
}

float3 evalPointLight(float3 pos, float3 N, float3 V, float3 albedo, float metallic, float roughness,
    float3 lightPos, float3 lightColor, float intensity, float radius)
{
    float3 L = lightPos - pos;
    float dist = length(L);
    if (dist >= radius) return float3(0, 0, 0);
    L /= dist;
    float att = 1.0 - smoothstep(radius * 0.5, radius, dist);
    att *= att;
    float NdotL = max(dot(N, L), 0.0);
    float3 diff = albedo * (1.0 - metallic) * lightColor * intensity * NdotL * att;
    float3 H = normalize(V + L);
    float NdotH = max(dot(N, H), 0.0);
    float spec = pow(NdotH, 64.0 * (1.0 - roughness));
    diff += (0.04 + albedo * metallic) * lightColor * intensity * spec * att;
    return diff;
}

float3 evalSpotLight(float3 pos, float3 N, float3 V, float3 albedo, float metallic, float roughness,
    float3 lightPos, float3 lightDir, float3 lightColor, float intensity, float range,
    float innerCos, float outerCos)
{
    float3 L = lightPos - pos;
    float dist = length(L);
    if (dist >= range) return float3(0, 0, 0);
    L /= dist;
    float cosTheta = dot(-L, lightDir);
    float spot = smoothstep(outerCos, innerCos, cosTheta);
    float att = (1.0 - dist / range) * (1.0 - dist / range);
    att *= spot;
    float NdotL = max(dot(N, L), 0.0);
    float3 diff = albedo * (1.0 - metallic) * lightColor * intensity * NdotL * att;
    float3 H = normalize(V + L);
    float NdotH = max(dot(N, H), 0.0);
    float spec = pow(NdotH, 64.0 * (1.0 - roughness));
    diff += (0.04 + albedo * metallic) * lightColor * intensity * spec * att;
    return diff;
}

void main(in PSInput PSIn, out float4 o_Color : SV_TARGET0)
{
    float3 pos = u_Position.Sample(u_LinearSampler, PSIn.TexCoord).rgb;
    float3 N = normalize(u_Normal.Sample(u_LinearSampler, PSIn.TexCoord).rgb);
    float3 albedo = u_Albedo.Sample(u_LinearSampler, PSIn.TexCoord).rgb;
    float2 mr = u_PBR.Sample(u_LinearSampler, PSIn.TexCoord).rg;
    float metallic = mr.r;
    float roughness = max(mr.g, 0.04);
    roughness = max(roughness * 0.8, 0.04);

    float3 V = normalize(u_ViewPos - pos);
    float3 L = normalize(-u_LightDir);
    float NdotL = max(dot(N, L), 0.0);

    float shadow = 0.0;
    if (u_UseShadows > 0)
        shadow = shadowFactor(pos);
    float lightVis = 1.0 - shadow;

    float3 diff = albedo * (1.0 - metallic) * u_Ambient;
    diff += albedo * u_LightColor * u_LightIntensity * NdotL * lightVis;

    float3 H = normalize(V + L);
    float NdotH = max(dot(N, H), 0.0);
    float spec = pow(NdotH, 64.0 * (1.0 - roughness));
    diff += (0.04 + albedo * metallic) * u_LightColor * u_LightIntensity * spec * lightVis;

    for (int i = 0; i < u_PointLightCount && i < MAX_POINT_LIGHTS; i++)
        diff += evalPointLight(pos, N, V, albedo, metallic, roughness,
            u_PointLightPos[i], u_PointLightColor[i], u_PointLightIntensity[i], u_PointLightRadius[i]);
    for (int i = 0; i < u_SpotLightCount && i < MAX_SPOT_LIGHTS; i++)
        diff += evalSpotLight(pos, N, V, albedo, metallic, roughness,
            u_SpotLightPos[i], normalize(u_SpotLightDir[i]), u_SpotLightColor[i],
            u_SpotLightIntensity[i], u_SpotLightRange[i],
            u_SpotLightInnerCos[i], u_SpotLightOuterCos[i]);

    float3 color = diff * u_Exposure;
    float lum = dot(color, float3(0.2126, 0.7152, 0.0722));
    color = lerp(float3(lum, lum, lum), color, 1.15);
    color = saturate(color);
    o_Color = float4(color, 1.0);
}
