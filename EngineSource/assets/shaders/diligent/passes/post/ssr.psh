// passes/post/ssr — same logic as opengl ssr.frag
Texture2D g_Position : register(t0);
Texture2D g_Normal : register(t1);
Texture2D g_Albedo : register(t2);
Texture2D g_PBRParams : register(t3);
Texture2D g_Depth : register(t4);
Texture2D u_SceneTexture : register(t5);
TextureCube u_Skybox : register(t6);
SamplerState u_LinearSampler : register(s0);

cbuffer Constants : register(b0)
{
    row_major float4x4 u_ViewMatrix;
    row_major float4x4 u_ProjectionMatrix;
    row_major float4x4 u_InverseViewMatrix;
    row_major float4x4 u_InverseProjectionMatrix;
    float3 u_ViewPos;
    float _pad0;
    float2 u_Resolution;
    float u_StepSize;
    int u_MaxSteps;
    float u_Thickness;
};

struct PSInput { float4 Position : SV_POSITION; float2 TexCoord : TEXCOORD0; };

float3 RayMarch(float3 rayOrigin, float3 rayDir, float rayLength)
{
    float stepSize = u_StepSize;
    for (int i = 0; i < u_MaxSteps; i++)
    {
        rayOrigin += rayDir * stepSize;
        float4 projected = mul(u_ProjectionMatrix, float4(rayOrigin, 1.0));
        projected.xy /= projected.w;
        float2 screenCoord = projected.xy * 0.5 + 0.5;
        if (screenCoord.x < 0.0 || screenCoord.x > 1.0 || screenCoord.y < 0.0 || screenCoord.y > 1.0)
            break;
        float3 samplePos = g_Position.Sample(u_LinearSampler, screenCoord).rgb;
        if (length(samplePos) < 0.001) continue;
        float depthDiff = abs(rayOrigin.z - samplePos.z);
        if (depthDiff > 0.0 && depthDiff < u_Thickness)
            return g_Albedo.Sample(u_LinearSampler, screenCoord).rgb;
    }
    return float3(-1.0, -1.0, -1.0);
}

void main(in PSInput PSIn, out float4 o_Color : SV_TARGET0)
{
    float3 position = g_Position.Sample(u_LinearSampler, PSIn.TexCoord).rgb;
    float3 normal = normalize(g_Normal.Sample(u_LinearSampler, PSIn.TexCoord).rgb);
    float3 sceneColor = u_SceneTexture.Sample(u_LinearSampler, PSIn.TexCoord).rgb;

    if (length(position) < 0.001) { o_Color = float4(sceneColor, 1.0); return; }

    float3 viewDir = normalize(u_ViewPos - position);
    float3 reflectDir = reflect(-viewDir, normal);
    float3 reflectionColor = RayMarch(position, reflectDir, 10.0);

    if (reflectionColor.r < -0.5)
    {
        float3 worldReflectDir = mul((float3x3)u_InverseViewMatrix, reflectDir);
        reflectionColor = u_Skybox.Sample(u_LinearSampler, worldReflectDir).rgb;
    }
    if (reflectionColor.r < -0.5) reflectionColor = sceneColor;

    float reflective = g_PBRParams.Sample(u_LinearSampler, PSIn.TexCoord).b;
    float fresnel = pow(1.0 - max(dot(normal, viewDir), 0.0), 2.0);
    float3 finalColor = lerp(sceneColor, reflectionColor, fresnel * 0.5 * reflective);
    o_Color = float4(finalColor, 1.0);
}
