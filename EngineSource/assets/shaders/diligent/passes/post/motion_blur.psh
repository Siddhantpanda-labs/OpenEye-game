Texture2D u_Texture : register(t0);
Texture2D g_Velocity : register(t1);
SamplerState u_LinearSampler : register(s0);
cbuffer Constants : register(b0) { float2 u_Resolution; float u_Intensity; int u_Samples; };
struct PSInput { float4 Position : SV_POSITION; float2 TexCoord : TEXCOORD0; };
void main(in PSInput PSIn, out float4 FragColor : SV_TARGET0)
{
    float2 velocity = g_Velocity.Sample(u_LinearSampler, PSIn.TexCoord).rg;
    if (length(velocity) < 0.001) { FragColor = u_Texture.Sample(u_LinearSampler, PSIn.TexCoord); return; }
    float2 texelSize = 1.0 / u_Resolution;
    float3 color = u_Texture.Sample(u_LinearSampler, PSIn.TexCoord).rgb;
    float2 offset = velocity * u_Intensity * texelSize;
    float weight = 1.0 / (float)(u_Samples + 1);
    color *= weight;
    for (int i = 1; i <= u_Samples; i++)
        color += u_Texture.Sample(u_LinearSampler, PSIn.TexCoord + offset * (float)i).rgb * weight;
    FragColor = float4(color, 1.0);
}
