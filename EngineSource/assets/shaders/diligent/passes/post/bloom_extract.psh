Texture2D u_HDRTexture : register(t0);
SamplerState u_LinearSampler : register(s0);
cbuffer Constants : register(b0) { float u_Threshold; };
struct PSInput { float4 Position : SV_POSITION; float2 TexCoord : TEXCOORD0; };
void main(in PSInput PSIn, out float4 FragColor : SV_TARGET0)
{
    float3 color = u_HDRTexture.Sample(u_LinearSampler, PSIn.TexCoord).rgb;
    float luminance = dot(color, float3(0.2126, 0.7152, 0.0722));
    float3 bloom = max(color - u_Threshold, 0.0);
    float smoothFactor = smoothstep(u_Threshold, u_Threshold * 1.5, luminance);
    bloom *= smoothFactor;
    FragColor = float4(bloom, 1.0);
}
