// Diligent HLSL: lit fragment (passes/forward/lit)
struct PSInput
{
    float4 Position : SV_POSITION;
    float3 PositionW : TEXCOORD0;
    float3 Normal   : TEXCOORD1;
    float2 TexCoord : TEXCOORD2;
};

// Vulkan std140: every block 16-byte aligned; float3 must be followed by pad to 16 bytes
cbuffer Material : register(b0)
{
    float3 u_Albedo;
    float  _pad0;
    float  u_Metallic;
    float  u_Roughness;
    float2 _pad1;
    float3 u_Emission;
    float  _pad2;
    float  u_Alpha;
    float  _pad3;
    float2 _pad4;
    float3 u_LightDir;
    float  _pad5;
    float  u_LightIntensity;
    float  _pad6;
    float2 _pad7;
    float3 u_LightColor;
    float  _pad8;
    float  u_Exposure;
    float  _pad9;
    float2 _pad10;
    float3 u_ViewPos;
    float  _pad11;
    float  u_Ambient_pad;
    float  _pad12;
    float2 _pad13;
    float3 u_Ambient;
    float  _pad14;
    float  u_ShadowBias;
    float  _pad15;
    float2 _pad16;
    int    u_UseShadows;
    float  _pad17;
    float2 _pad18;
};

Texture2D u_ShadowMap : register(t0);
SamplerState u_ShadowMap_sampler : register(s0);

void main(in PSInput PSIn, out float4 FragColor : SV_TARGET0)
{
    float3 N = normalize(PSIn.Normal);
    float3 L = normalize(-u_LightDir);
    float NdotL = max(dot(N, L), 0.0);
    float shadow = (u_UseShadows > 0) ? 0.0 : 0.0;
    float3 diffuse = u_Albedo * u_LightColor * u_LightIntensity * NdotL * (1.0 - shadow);
    float3 ambient = u_Albedo * u_Ambient;
    FragColor = float4((ambient + diffuse + u_Emission) * u_Exposure, u_Alpha);
}
