// Diligent HLSL: passes/forward/forwardplus_skinned — same fragment as forwardplus.psh
struct PSInput
{
    float4 Position   : SV_POSITION;
    float3 WorldPos   : TEXCOORD0;
    float3 ViewPos    : TEXCOORD1;
    float3 WorldNormal : TEXCOORD2;
    float2 TexCoord   : TEXCOORD3;
    float3x3 TBN      : TEXCOORD4;
};

cbuffer Constants : register(b0)
{
    float3 u_ViewPos;
    float _pad0;
    float3 u_Albedo;
    float u_Metallic;
    float u_Roughness;
    float u_AO;
    float u_Alpha;
    float3 u_Emission;
    float _pad1;
    float3 u_DirLightDir;
    float u_DirLightIntensity;
    float3 u_DirLightColor;
    float u_Exposure;
    float3 u_Ambient;
    float u_NearPlane;
    float u_FarPlane;
    float u_LogNear;
    float u_LogFar;
    int u_ScreenWidth;
    int u_ScreenHeight;
    int u_TileCountX;
    int u_TileCountY;
    int u_SliceCount;
    int u_PointLightCount;
    int u_SpotLightCount;
    int u_UseShadows;
    int u_UseAlbedoTexture;
    int u_UseNormalTexture;
    int u_UseMetallicRoughnessTexture;
    int u_UseAOTexture;
    int u_UseEmissiveTexture;
    float u_ShadowBias;
    row_major float4x4 u_LightSpaceMatrix;
};

struct PointLight
{
    float3 position;
    float _pad0;
    float3 color;
    float intensity;
    float radius;
    float _pad1;
    float _pad2;
    float _pad3;
};

struct SpotLight
{
    float3 position;
    float _pad0;
    float3 direction;
    float _pad1;
    float3 color;
    float intensity;
    float range;
    float innerConeCos;
    float outerConeCos;
    float _pad2;
    float _pad3;
    float _pad4;
    float _pad5;
    float _pad6;
};

Texture2D u_AlbedoTexture : register(t0);
Texture2D u_NormalTexture : register(t1);
Texture2D u_MetallicRoughnessTexture : register(t2);
Texture2D u_AOTexture : register(t3);
Texture2D u_EmissiveTexture : register(t4);
Texture2D u_ShadowMap : register(t5);
StructuredBuffer<uint> lightIndices : register(t6);
StructuredBuffer<PointLight> pointLights : register(t7);
StructuredBuffer<SpotLight> spotLights : register(t8);
SamplerState u_LinearSampler : register(s0);
SamplerState u_ShadowSampler : register(s5);

float shadowFactor(float3 worldPos)
{
    if (u_UseShadows <= 0) return 0.0;
    float4 lightSpacePos = mul(u_LightSpaceMatrix, float4(worldPos, 1.0));
    float3 ndc = lightSpacePos.xyz / lightSpacePos.w;
    ndc = ndc * 0.5 + 0.5;
    if (ndc.z > 1.0 || ndc.x < 0.0 || ndc.x > 1.0 || ndc.y < 0.0 || ndc.y > 1.0)
        return 0.0;
    float depth = u_ShadowMap.Sample(u_ShadowSampler, ndc.xy).r;
    return (ndc.z - u_ShadowBias > depth) ? 1.0 : 0.0;
}

float3 calc_point_light(float3 pos, float3 color, float intensity, float radius,
    float3 fragPos, float3 normal, float3 viewDir, float3 albedo, float metallic, float roughness)
{
    float3 lightDir = normalize(pos - fragPos);
    float dist = length(pos - fragPos);
    float atten = 1.0 / (1.0 + 0.09 * dist + 0.032 * dist * dist);
    atten *= smoothstep(radius, radius * 0.5, dist);
    float NdotL = max(dot(normal, lightDir), 0.0);
    float3 H = normalize(viewDir + lightDir);
    float NdotH = max(dot(normal, H), 0.0);
    float spec = pow(NdotH, 64.0 * (1.0 - roughness));
    float3 diff = albedo * (1.0 - metallic) * NdotL + (0.04 + albedo * metallic) * spec;
    return diff * color * intensity * atten;
}

float3 calc_spot_light(float3 pos, float3 dir, float3 color, float intensity, float range,
    float innerCos, float outerCos, float3 fragPos, float3 normal, float3 viewDir,
    float3 albedo, float metallic, float roughness)
{
    float3 lightDir = normalize(pos - fragPos);
    float dist = length(pos - fragPos);
    if (dist > range) return float3(0, 0, 0);
    float cosAngle = dot(lightDir, -dir);
    float spot = smoothstep(outerCos, innerCos, cosAngle);
    float atten = 1.0 / (1.0 + 0.09 * dist + 0.032 * dist * dist);
    float NdotL = max(dot(normal, lightDir), 0.0);
    float3 H = normalize(viewDir + lightDir);
    float NdotH = max(dot(normal, H), 0.0);
    float spec = pow(NdotH, 64.0 * (1.0 - roughness));
    float3 diff = albedo * (1.0 - metallic) * NdotL + (0.04 + albedo * metallic) * spec;
    return diff * color * intensity * atten * spot;
}

void main(in PSInput PSIn, out float4 o_Color : SV_TARGET0)
{
    float3 N = normalize(PSIn.WorldNormal);
    if (u_UseNormalTexture > 0)
    {
        float3 n = u_NormalTexture.Sample(u_LinearSampler, PSIn.TexCoord).xyz * 2.0 - 1.0;
        N = normalize(mul(PSIn.TBN, n));
    }
    float3 V = normalize(u_ViewPos - PSIn.WorldPos);
    float3 albedo = u_UseAlbedoTexture > 0
        ? u_AlbedoTexture.Sample(u_LinearSampler, PSIn.TexCoord).rgb * u_Albedo
        : u_Albedo;
    float metallic = u_Metallic;
    float roughness = u_Roughness;
    if (u_UseMetallicRoughnessTexture > 0)
    {
        float2 mr = u_MetallicRoughnessTexture.Sample(u_LinearSampler, PSIn.TexCoord).bg;
        metallic = mr.x;
        roughness = mr.y;
    }
    roughness = max(roughness, 0.04);

    float ao = u_AO;
    if (u_UseAOTexture > 0)
        ao = u_AOTexture.Sample(u_LinearSampler, PSIn.TexCoord).r;

    float3 emission = u_Emission;
    if (u_UseEmissiveTexture > 0)
        emission = u_EmissiveTexture.Sample(u_LinearSampler, PSIn.TexCoord).rgb;

    float3 result = albedo * u_Ambient * ao;
    float3 L = normalize(-u_DirLightDir);
    float NdotL = max(dot(N, L), 0.0);
    float shadow = shadowFactor(PSIn.WorldPos);
    float lightVis = 1.0 - shadow;
    result += albedo * u_DirLightColor * u_DirLightIntensity * NdotL * lightVis;

    float viewZ = abs(PSIn.ViewPos.z);
    float viewZClamped = clamp(viewZ, u_NearPlane, u_FarPlane);
    float logViewZ = log(viewZClamped);
    float sliceF = (logViewZ - u_LogNear) / (u_LogFar - u_LogNear) * u_SliceCount;
    uint sliceZ = (uint)clamp(sliceF, 0.0, (float)u_SliceCount - 1.0);
    uint tileX = (uint)PSIn.Position.x / 16u;
    uint tileY = (uint)PSIn.Position.y / 16u;
    uint clusterIdx = (sliceZ * (uint)u_TileCountY + tileY) * (uint)u_TileCountX + tileX;
    uint offset = clusterIdx * 255u;

    for (uint i = 0; i < 255; i++)
    {
        uint lidx = lightIndices[offset + i];
        if (lidx >= 255u) break;
        int idx = (int)lidx;
        if (idx < u_PointLightCount)
        {
            PointLight pl = pointLights[idx];
            result += calc_point_light(pl.position, pl.color, pl.intensity, pl.radius,
                PSIn.WorldPos, N, V, albedo, metallic, roughness);
        }
        else
        {
            int sidx = idx - u_PointLightCount;
            if (sidx < u_SpotLightCount)
            {
                SpotLight sl = spotLights[sidx];
                result += calc_spot_light(sl.position, sl.direction, sl.color, sl.intensity, sl.range,
                    sl.innerConeCos, sl.outerConeCos, PSIn.WorldPos, N, V, albedo, metallic, roughness);
            }
        }
    }

    result += emission;
    o_Color = float4(result * u_Exposure, u_Alpha);
}
