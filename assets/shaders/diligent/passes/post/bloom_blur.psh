Texture2D u_Texture : register(t0);
SamplerState u_LinearSampler : register(s0);
cbuffer Constants : register(b0)
{
    int u_Horizontal;
    float u_Intensity;
    float2 u_Resolution;
};
struct PSInput { float4 Position : SV_POSITION; float2 TexCoord : TEXCOORD0; };
static const float weights[5] = { 0.227027, 0.1945946, 0.1216216, 0.054054, 0.016216 };
void main(in PSInput PSIn, out float4 FragColor : SV_TARGET0)
{
    float2 texelSize = 1.0 / u_Resolution;
    float3 result = u_Texture.Sample(u_LinearSampler, PSIn.TexCoord).rgb * weights[0];
    float blurRadius = u_Intensity;
    if (u_Horizontal)
    {
        for (int i = 1; i < 5; i++)
        {
            float offset = (float)i * blurRadius;
            result += u_Texture.Sample(u_LinearSampler, PSIn.TexCoord + float2(texelSize.x * offset, 0.0)).rgb * weights[i];
            result += u_Texture.Sample(u_LinearSampler, PSIn.TexCoord - float2(texelSize.x * offset, 0.0)).rgb * weights[i];
        }
    }
    else
    {
        for (int i = 1; i < 5; i++)
        {
            float offset = (float)i * blurRadius;
            result += u_Texture.Sample(u_LinearSampler, PSIn.TexCoord + float2(0.0, texelSize.y * offset)).rgb * weights[i];
            result += u_Texture.Sample(u_LinearSampler, PSIn.TexCoord - float2(0.0, texelSize.y * offset)).rgb * weights[i];
        }
    }
    FragColor = float4(result, 1.0);
}
