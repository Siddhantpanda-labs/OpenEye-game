#version 460 core
// No-draw-list variant: writes one indirect command (single quad) at slot 0.
// Used when no draw list is present; binding 1 (DrawListIn) is not declared.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct DrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  baseVertex;
    uint baseInstance;
};

layout(std430, binding = 0) buffer IndirectOut {
    DrawIndexedIndirectCommand outCommands[];
};

layout(std140, binding = 3) uniform ViewProjBlock {
    mat4 u_ViewProj;
};
uniform uint u_NumDraws;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id == 0u) {
        outCommands[0].indexCount = 6u;
        outCommands[0].instanceCount = 1u;
        outCommands[0].firstIndex = 0u;
        outCommands[0].baseVertex = 0;
        outCommands[0].baseInstance = 0u;
    }
}
