# BGFX from thirdparty (manual). OPENEYE_USE_BGFX defined in root.
# Expects thirdparty/bgfx.cmake with bx, bimg, bgfx as submodules. See thirdparty/README_BGFX.md.
if(OPENEYE_USE_BGFX)
    set(BGFX_CMAKE_DIR "${CMAKE_SOURCE_DIR}/thirdparty/bgfx.cmake")
    if(EXISTS "${BGFX_CMAKE_DIR}/CMakeLists.txt")
        set(BGFX_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
        set(BGFX_BUILD_TESTS OFF CACHE BOOL "" FORCE)
        set(BGFX_BUILD_TOOLS ON CACHE BOOL "" FORCE)
        set(BGFX_BUILD_TOOLS_SHADER ON CACHE BOOL "" FORCE)
        set(BGFX_INSTALL OFF CACHE BOOL "" FORCE)
        set(BGFX_LIBRARY_TYPE "STATIC" CACHE STRING "" FORCE)
        set(BGFX_CONFIG_MULTITHREADED OFF CACHE BOOL "" FORCE)  # single-threaded: simpler init, avoid render-thread designation issues
        set(BGFX_AMALGAMATED OFF CACHE BOOL "" FORCE)
        set(BX_AMALGAMATED OFF CACHE BOOL "" FORCE)
        add_subdirectory(${BGFX_CMAKE_DIR} ${CMAKE_BINARY_DIR}/thirdparty/bgfx.cmake)
        # shaderc: add glslang Include for BaseTypes.h; exclude WGSL source (needs Tint, not in tree)
        if(TARGET glslang)
            target_include_directories(glslang PUBLIC ${BGFX_CMAKE_DIR}/bgfx/3rdparty/glslang/glslang/Include)
        endif()
        if(TARGET shaderc)
            get_target_property(SHADERC_SRCS shaderc SOURCES)
            list(FILTER SHADERC_SRCS EXCLUDE REGEX ".*shaderc_wgsl\\.cpp$")
            set_target_properties(shaderc PROPERTIES SOURCES "${SHADERC_SRCS}")
            target_sources(shaderc PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/cmake/shaderc_wgsl_stub.cpp)
            target_include_directories(shaderc PRIVATE ${BGFX_CMAKE_DIR}/bgfx/tools/shaderc)
        endif()
        # bx/bimg/bgfx and tools (e.g. shaderc) require C++20; bgfx.cmake defaults to C++17
        foreach(_t bx bimg bgfx shaderc)
            if(TARGET ${_t})
                set_target_properties(${_t} PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED ON)
            endif()
        endforeach()
        # MSVC: __try in bx thread.cpp requires /EHa (SEH with C++ unwinding)
        if(MSVC AND TARGET bx)
            target_compile_options(bx PRIVATE /EHa)
        endif()
        set(OPENEYE_BGFX_AVAILABLE 1)
        set(OPENEYE_BGFX_SOURCE_DIR ${BGFX_CMAKE_DIR})
    else()
        message(WARNING "OPENEYE_USE_BGFX=ON but thirdparty/bgfx.cmake not found. See thirdparty/README_BGFX.md to add bgfx.")
        set(OPENEYE_BGFX_AVAILABLE 0)
    endif()
else()
    set(OPENEYE_BGFX_AVAILABLE 0)
endif()
