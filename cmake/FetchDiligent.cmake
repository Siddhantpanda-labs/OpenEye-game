# Diligent Engine (DiligentCore) - optional RHI backend.
# Looks for thirdparty/DiligentCore or thirdparty/diligent/DiligentCore. See thirdparty/README_Diligent.md.
if(OPENEYE_USE_DILIGENT)
    set(_diligent_core "${CMAKE_SOURCE_DIR}/thirdparty/DiligentCore")
    if(NOT EXISTS "${_diligent_core}/CMakeLists.txt")
        set(_diligent_core "${CMAKE_SOURCE_DIR}/thirdparty/diligent/DiligentCore")
    endif()
    set(DILIGENT_CORE_DIR "${_diligent_core}")
    if(EXISTS "${DILIGENT_CORE_DIR}/CMakeLists.txt")
        set(OPENEYE_DILIGENT_AVAILABLE 1 CACHE INTERNAL "DiligentCore found and will be built")
        set(DILIGENT_BUILD_TESTS OFF CACHE BOOL "" FORCE)
        set(DILIGENT_INSTALL_CORE OFF CACHE BOOL "" FORCE)
        # Build OpenGL, D3D11, and Vulkan. Force Vulkan ON (overrides cache from earlier runs).
        set(DILIGENT_NO_DIRECT3D12 ON CACHE BOOL "" FORCE)
        set(DILIGENT_NO_WEBGPU ON CACHE BOOL "" FORCE)
        set(DILIGENT_NO_VULKAN OFF CACHE BOOL "" FORCE)
        add_subdirectory(${DILIGENT_CORE_DIR} ${CMAKE_BINARY_DIR}/thirdparty/DiligentCore)
        set(OPENEYE_DILIGENT_SOURCE_DIR ${DILIGENT_CORE_DIR} CACHE INTERNAL "DiligentCore source dir")
    else()
        message(WARNING "OPENEYE_USE_DILIGENT=ON but thirdparty/DiligentCore not found. See thirdparty/README_Diligent.md.")
        set(OPENEYE_DILIGENT_AVAILABLE 0 CACHE INTERNAL "DiligentCore not available")
    endif()
else()
    set(OPENEYE_DILIGENT_AVAILABLE 0 CACHE INTERNAL "Diligent not requested")
endif()
