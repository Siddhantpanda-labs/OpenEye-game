// Diligent HLSL: passes/deferred/gbuffer_skinned (same logic as opengl passes/deferred/gbuffer_skinned.frag)
// MRT: Position(0), Normal(1), Albedo(2), PBR(3), Velocity(4)

struct PSInput
{
    float4 Position   : SV_POSITION;
    float3 WorldPos   : TEXCOORD0;
    float3 WorldNormal : TEXCOORD1;
    float2 TexCoord   : TEXCOORD2;
    float2 Velocity   : TEXCOORD3;
    float3x3 TBN      : TEXCOORD4;
};

cbuffer Material : register(b0)
{
    float3 u_Albedo;
    float u_Metallic;
    float u_Roughness;
    float u_AO;
    float u_HasAlbedoTexture;
    float u_HasNormalTexture;
    float u_HasMetallicRoughnessTexture;
    float u_HasAOTexture;
    float u_HasMetallicTexture;
    float u_HasRoughnessTexture;
};

Texture2D u_AlbedoTexture : register(t0);
Texture2D u_NormalTexture : register(t1);
Texture2D u_MetallicTexture : register(t2);
Texture2D u_RoughnessTexture : register(t3);
Texture2D u_AOTexture : register(t4);
Texture2D u_MetallicRoughnessTexture : register(t5);
Texture2D u_EmissiveTexture : register(t6);
SamplerState u_LinearSampler : register(s0);

struct PSOutput
{
    float4 g_Position : SV_TARGET0;
    float4 g_Normal   : SV_TARGET1;
    float4 g_Albedo   : SV_TARGET2;
    float2 g_PBRParams : SV_TARGET3;
    float2 g_Velocity : SV_TARGET4;
};

void main(in PSInput PSIn, out PSOutput PSOut)
{
    PSOut.g_Position = float4(PSIn.WorldPos, 1.0);

    float3 normal = normalize(PSIn.WorldNormal);
    if (u_HasNormalTexture > 0.5)
    {
        float3 normalSample = u_NormalTexture.Sample(u_LinearSampler, PSIn.TexCoord).rgb;
        normalSample = normalSample * 2.0 - 1.0;
        normal = normalize(mul(PSIn.TBN, normalSample));
    }
    if (any(isnan(normal)))
        normal = float3(0, 1, 0);
    PSOut.g_Normal = float4(normal, 1.0);

    float3 albedoColor = u_Albedo;
    if (u_HasAlbedoTexture > 0.5)
        albedoColor = u_AlbedoTexture.Sample(u_LinearSampler, PSIn.TexCoord).rgb * u_Albedo;
    PSOut.g_Albedo = float4(saturate(albedoColor), 1.0);

    float metallic = u_Metallic;
    float roughness = u_Roughness;
    if (u_HasMetallicRoughnessTexture > 0.5)
    {
        float2 mr = u_MetallicRoughnessTexture.Sample(u_LinearSampler, PSIn.TexCoord).bg;
        metallic = mr.x;
        roughness = mr.y;
    }
    else
    {
        if (u_HasMetallicTexture > 0.5) metallic = u_MetallicTexture.Sample(u_LinearSampler, PSIn.TexCoord).r;
        if (u_HasRoughnessTexture > 0.5) roughness = u_RoughnessTexture.Sample(u_LinearSampler, PSIn.TexCoord).r;
    }
    PSOut.g_PBRParams = float2(saturate(metallic), clamp(roughness, 0.04, 1.0));
    PSOut.g_Velocity = PSIn.Velocity;
}
