// passes/post/ssao — same logic as opengl ssao.frag (camera from cbuffer)
Texture2D g_Position : register(t0);
Texture2D g_Normal : register(t1);
Texture2D g_Depth : register(t2);
SamplerState u_LinearSampler : register(s0);

cbuffer Constants : register(b0)
{
    row_major float4x4 u_ViewMatrix;
    row_major float4x4 u_ProjectionMatrix;
    float u_Radius;
    float u_Bias;
    int u_SampleCount;
    float2 u_Resolution;
};

static const float3 sampleKernel[16] = {
    float3( 0.04977, -0.04471, 0.04996), float3( 0.01457,  0.01653, 0.00224),
    float3(-0.04065, -0.01937, 0.03193), float3( 0.01378, -0.09158, 0.04092),
    float3( 0.05599,  0.05979, 0.05766), float3( 0.09227,  0.04428, 0.01545),
    float3(-0.00204, -0.00433, 0.00217), float3(-0.00033, -0.00068, 0.00032),
    float3( 0.05004, -0.00265, 0.04987), float3( 0.03813,  0.03142, 0.03286),
    float3(-0.03188,  0.02051, 0.02251), float3( 0.0557,  -0.03697, 0.04049),
    float3( 0.05743, -0.0229,  0.05454), float3(-0.03555, -0.00099, 0.00016),
    float3( 0.01698, -0.00898, 0.00374), float3(-0.02729, -0.06378, 0.03263)
};

float3 RandomVec3(float2 texCoords)
{
    float r = frac(sin(dot(texCoords, float2(12.9898, 78.233))) * 43758.5453);
    float r2 = frac(sin(dot(texCoords + float2(1,0), float2(12.9898, 78.233))) * 43758.5453);
    float r3 = frac(sin(dot(texCoords + float2(0,1), float2(12.9898, 78.233))) * 43758.5453);
    return normalize(float3(r*2-1, r2*2-1, r3*2-1));
}

struct PSInput { float4 Position : SV_POSITION; float2 TexCoord : TEXCOORD0; };

void main(in PSInput PSIn, out float FragColor : SV_TARGET0)
{
    float3 position = g_Position.Sample(u_LinearSampler, PSIn.TexCoord).rgb;
    float3 normal = normalize(g_Normal.Sample(u_LinearSampler, PSIn.TexCoord).rgb);
    if (length(position) < 0.001) { FragColor = 1.0; return; }

    float3 randomVec = RandomVec3(PSIn.TexCoord);
    float3 tangent = normalize(randomVec - normal * dot(randomVec, normal));
    float3 bitangent = cross(normal, tangent);
    float3x3 TBN = float3x3(tangent, bitangent, normal);

    float occlusion = 0.0;
    for (int i = 0; i < 16 && i < u_SampleCount; i++)
    {
        float3 samplePos = position + mul(TBN, sampleKernel[i] * u_Radius);
        float4 samplePosView = mul(u_ViewMatrix, float4(samplePos, 1.0));
        float4 offset = mul(u_ProjectionMatrix, samplePosView);
        offset.xy /= offset.w;
        offset.xy = offset.xy * 0.5 + 0.5;

        float3 samplePosition = g_Position.Sample(u_LinearSampler, offset.xy).rgb;
        float distanceToSample = length(samplePos - position);
        float rangeCheck = smoothstep(0.0, 1.0, u_Radius / distanceToSample);
        float depthDiff = samplePosView.z - mul(u_ViewMatrix, float4(samplePosition, 1.0)).z;
        if (depthDiff > -u_Bias && depthDiff < u_Radius)
            occlusion += rangeCheck;
    }
    FragColor = 1.0 - (occlusion / (float)u_SampleCount);
}
