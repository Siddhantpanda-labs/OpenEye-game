Texture2D u_SceneTexture : register(t0);
Texture2D u_BloomTexture : register(t1);
SamplerState u_LinearSampler : register(s0);
cbuffer Constants : register(b0) { float u_BloomIntensity; };
struct PSInput { float4 Position : SV_POSITION; float2 TexCoord : TEXCOORD0; };
void main(in PSInput PSIn, out float4 FragColor : SV_TARGET0)
{
    float3 scene = u_SceneTexture.Sample(u_LinearSampler, PSIn.TexCoord).rgb;
    float3 bloom = u_BloomTexture.Sample(u_LinearSampler, PSIn.TexCoord).rgb;
    FragColor = float4(scene + bloom * u_BloomIntensity, 1.0);
}
