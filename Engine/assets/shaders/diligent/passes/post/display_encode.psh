// passes/post/display_encode — linear LDR → sRGB for 8-bit UNORM (same as Vulkan/OpenGL)
Texture2D u_Texture : register(t0);
SamplerState u_LinearSampler : register(s0);

struct PSInput { float4 Position : SV_POSITION; float2 TexCoord : TEXCOORD0; };

float3 LinearToSRGB(float3 linear)
{
    float3 low = linear * 12.92;
    float3 high = 1.055 * pow(linear, 1.0 / 2.4) - 0.055;
    return lerp(low, high, step(0.0031308, linear));
}

void main(in PSInput PSIn, out float4 FragColor : SV_TARGET0)
{
    float3 linear = u_Texture.Sample(u_LinearSampler, PSIn.TexCoord).rgb;
    FragColor = float4(LinearToSRGB(saturate(linear)), 1.0);
}
