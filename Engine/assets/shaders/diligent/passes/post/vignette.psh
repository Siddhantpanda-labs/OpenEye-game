Texture2D u_Texture : register(t0);
SamplerState u_LinearSampler : register(s0);
cbuffer Constants : register(b0) { float u_Intensity; float u_Radius; float u_Softness; };
struct PSInput { float4 Position : SV_POSITION; float2 TexCoord : TEXCOORD0; };
void main(in PSInput PSIn, out float4 FragColor : SV_TARGET0)
{
    float3 color = u_Texture.Sample(u_LinearSampler, PSIn.TexCoord).rgb;
    float dist = distance(PSIn.TexCoord, float2(0.5, 0.5));
    float vignette = smoothstep(u_Radius, u_Radius + u_Softness, dist);
    vignette = 1.0 - (vignette * u_Intensity);
    FragColor = float4(color * vignette, 1.0);
}
