#define FXAA_REDUCE_MIN (1.0 / 128.0)
#define FXAA_REDUCE_MUL (1.0 / 8.0)
#define FXAA_SPAN_MAX 8.0

Texture2D u_Texture : register(t0);
SamplerState u_LinearSampler : register(s0);
cbuffer Constants : register(b0) { float2 u_Resolution; };
struct PSInput { float4 Position : SV_POSITION; float2 TexCoord : TEXCOORD0; };

void main(in PSInput PSIn, out float4 FragColor : SV_TARGET0)
{
    float2 texelSize = 1.0 / u_Resolution;
    float2 uv = PSIn.TexCoord;
    float3 rgbNW = u_Texture.Sample(u_LinearSampler, uv + float2(-1,-1) * texelSize).rgb;
    float3 rgbNE = u_Texture.Sample(u_LinearSampler, uv + float2( 1,-1) * texelSize).rgb;
    float3 rgbSW = u_Texture.Sample(u_LinearSampler, uv + float2(-1, 1) * texelSize).rgb;
    float3 rgbSE = u_Texture.Sample(u_LinearSampler, uv + float2( 1, 1) * texelSize).rgb;
    float3 rgbM = u_Texture.Sample(u_LinearSampler, uv).rgb;

    float3 luma = float3(0.299, 0.587, 0.114);
    float lumaNW = dot(rgbNW, luma), lumaNE = dot(rgbNE, luma), lumaSW = dot(rgbSW, luma), lumaSE = dot(rgbSE, luma), lumaM = dot(rgbM, luma);
    float lumaMin = min(lumaM, min(min(lumaNW, lumaNE), min(lumaSW, lumaSE)));
    float lumaMax = max(lumaM, max(max(lumaNW, lumaNE), max(lumaSW, lumaSE)));

    float2 dir;
    dir.x = -((lumaNW + lumaNE) - (lumaSW + lumaSE));
    dir.y = ((lumaNW + lumaSW) - (lumaNE + lumaSE));
    float dirReduce = max((lumaNW + lumaNE + lumaSW + lumaSE) * (0.25 * FXAA_REDUCE_MUL), FXAA_REDUCE_MIN);
    float rcpDirMin = 1.0 / (min(abs(dir.x), abs(dir.y)) + dirReduce);
    dir = min(float2(FXAA_SPAN_MAX, FXAA_SPAN_MAX), max(float2(-FXAA_SPAN_MAX, -FXAA_SPAN_MAX), dir * rcpDirMin)) * texelSize;

    float3 rgbA = 0.5 * (
        u_Texture.Sample(u_LinearSampler, uv + dir * (1.0/3.0 - 0.5)).rgb +
        u_Texture.Sample(u_LinearSampler, uv + dir * (2.0/3.0 - 0.5)).rgb);
    float3 rgbB = rgbA * 0.5 + 0.25 * (
        u_Texture.Sample(u_LinearSampler, uv + dir * -0.5).rgb +
        u_Texture.Sample(u_LinearSampler, uv + dir * 0.5).rgb);
    float lumaB = dot(rgbB, luma);
    FragColor = (lumaB < lumaMin || lumaB > lumaMax) ? float4(rgbA, 1.0) : float4(rgbB, 1.0);
}
