#version 430 core
// Streaming: RGBA texture -> NV12 buffer (Y plane + interleaved UV). BT.709, pitch-aligned.
// Layout: Y at 0, pitch*height bytes; UV at pitch*height, pitch*(height/2) bytes, interleaved U,V.
// Uses uint buffer (byte-packed) for portability; no uint8_t or vendor extensions.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_src;

layout(std430, binding = 0) buffer Nv12Out {
    uint data[];
};

uniform uint u_Width;
uniform uint u_Height;
uniform uint u_Pitch;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(u_Width) || px.y >= int(u_Height)) return;

    // Y: pack 4 consecutive pixels (in X) per uint when px.x % 4 == 0
    if (px.x % 4 == 0) {
        float y0 = 0.0, y1 = 0.0, y2 = 0.0, y3 = 0.0;
        for (int i = 0; i < 4 && (px.x + i) < int(u_Width); ++i) {
            vec4 c = texelFetch(u_src, px + ivec2(i, 0), 0);
            float r = c.r * 255.0, g = c.g * 255.0, b = c.b * 255.0;
            float y = clamp(0.2126 * r + 0.7152 * g + 0.0722 * b + 16.0, 0.0, 255.0);
            if (i == 0) y0 = y; else if (i == 1) y1 = y; else if (i == 2) y2 = y; else y3 = y;
        }
        uint yIdx = uint(px.y) * u_Pitch + uint(px.x);
        data[yIdx / 4u] = uint(y0) | (uint(y1) << 8u) | (uint(y2) << 16u) | (uint(y3) << 24u);
    }

    // UV: one uint = 2 UV pairs (4 bytes). Write when px.x % 4 == 0 && px.y % 2 == 0.
    if (px.x % 4 == 0 && px.y % 2 == 0) {
        ivec2 b0 = px;
        ivec2 b1 = px + ivec2(2, 0);
        float u0 = 0.0, v0 = 0.0, u1 = 0.0, v1 = 0.0;
        for (int block = 0; block < 2; ++block) {
            ivec2 base = (block == 0) ? b0 : b1;
            if (base.x + 1 >= int(u_Width) || base.y + 1 >= int(u_Height)) break;
            vec4 c00 = texelFetch(u_src, base, 0);
            vec4 c10 = texelFetch(u_src, base + ivec2(1, 0), 0);
            vec4 c01 = texelFetch(u_src, base + ivec2(0, 1), 0);
            vec4 c11 = texelFetch(u_src, base + ivec2(1, 1), 0);
            float r_ = (c00.r + c10.r + c01.r + c11.r) * 0.25 * 255.0;
            float g_ = (c00.g + c10.g + c01.g + c11.g) * 0.25 * 255.0;
            float b_ = (c00.b + c10.b + c01.b + c11.b) * 0.25 * 255.0;
            float u = clamp((-0.1146 * r_ - 0.3854 * g_ + 0.5 * b_) + 128.0, 0.0, 255.0);
            float v = clamp((0.5 * r_ - 0.4542 * g_ - 0.0458 * b_) + 128.0, 0.0, 255.0);
            if (block == 0) { u0 = u; v0 = v; } else { u1 = u; v1 = v; }
        }
        uint uvRow = uint(px.y / 2);
        uint uvCol = uint(px.x / 2);
        uint uvByteOff = uvRow * u_Pitch + uvCol * 2u;
        uint uvBase = u_Height * u_Pitch;
        data[(uvBase + uvByteOff) / 4u] = uint(u0) | (uint(v0) << 8u) | (uint(u1) << 16u) | (uint(v1) << 24u);
    }
}
