#version 450
// Vulkan: frustum cull with draw list; writes indirect commands. Layout matches GpuCullDrawEntry.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct DrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  baseVertex;
    uint baseInstance;
};

struct DrawEntry {
    float aabbMinX, aabbMinY, aabbMinZ;
    float _pad0;
    float aabbMaxX, aabbMaxY, aabbMaxZ;
    float _pad1;
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  baseVertex;
    uint baseInstance;
};

layout(set = 0, binding = 0) buffer IndirectOut {
    DrawIndexedIndirectCommand outCommands[];
};

layout(set = 0, binding = 1) readonly buffer DrawListIn {
    DrawEntry drawList[];
};

layout(set = 0, binding = 4) uniform sampler2D u_DepthTex;

layout(set = 0, binding = 5) uniform ViewProjBlock {
    mat4 u_ViewProj;
};
layout(push_constant, std430) uniform Push {
    uint u_NumDraws;
    int u_UseOcclusionCull;
    vec2 u_DepthSize;
} pc;

vec4 frustumPlanes[6];

void deriveFrustumPlanes() {
    mat4 M = u_ViewProj;
    frustumPlanes[0] = vec4(M[0][3] + M[0][0], M[1][3] + M[1][0], M[2][3] + M[2][0], M[3][3] + M[3][0]);
    frustumPlanes[1] = vec4(M[0][3] - M[0][0], M[1][3] - M[1][0], M[2][3] - M[2][0], M[3][3] - M[3][0]);
    frustumPlanes[2] = vec4(M[0][3] + M[0][1], M[1][3] + M[1][1], M[2][3] + M[2][1], M[3][3] + M[3][1]);
    frustumPlanes[3] = vec4(M[0][3] - M[0][1], M[1][3] - M[1][1], M[2][3] - M[2][1], M[3][3] - M[3][1]);
    frustumPlanes[4] = vec4(M[0][3] + M[0][2], M[1][3] + M[1][2], M[2][3] + M[2][2], M[3][3] + M[3][2]);
    frustumPlanes[5] = vec4(M[0][3] - M[0][2], M[1][3] - M[1][2], M[2][3] - M[2][2], M[3][3] - M[3][2]);
    for (int i = 0; i < 6; ++i)
        frustumPlanes[i] /= length(frustumPlanes[i].xyz);
}

bool aabbVisible(vec3 aabbMin, vec3 aabbMax) {
    vec3 center = (aabbMin + aabbMax) * 0.5;
    vec3 halfExtent = (aabbMax - aabbMin) * 0.5;
    for (int i = 0; i < 6; ++i) {
        vec3 n = frustumPlanes[i].xyz;
        float d = frustumPlanes[i].w;
        float r = dot(halfExtent, abs(n));
        if (dot(center, n) + d + r < 0.0)
            return false;
    }
    return true;
}

bool notOccluded(vec3 aabbMin, vec3 aabbMax) {
    vec3 center = (aabbMin + aabbMax) * 0.5;
    vec4 clip = u_ViewProj * vec4(center, 1.0);
    if (clip.w <= 0.0) return true;
    vec2 ndc = clip.xy / clip.w;
    if (ndc.x < -1.0 || ndc.x > 1.0 || ndc.y < -1.0 || ndc.y > 1.0) return true;
    float ndcZ = clip.z / clip.w;
    float depthVal = ndcZ * 0.5 + 0.5;
    vec2 uv = ndc * 0.5 + 0.5;
    uv.y = 1.0 - uv.y;
    float sampledDepth = texture(u_DepthTex, uv).r;
    const float epsilon = 0.0001;
    return depthVal <= sampledDepth + epsilon;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= pc.u_NumDraws)
        return;

    deriveFrustumPlanes();
    DrawEntry e = drawList[id];
    vec3 aabbMin = vec3(e.aabbMinX, e.aabbMinY, e.aabbMinZ);
    vec3 aabbMax = vec3(e.aabbMaxX, e.aabbMaxY, e.aabbMaxZ);
    bool visible = aabbVisible(aabbMin, aabbMax);
    if (visible && pc.u_UseOcclusionCull != 0)
        visible = notOccluded(aabbMin, aabbMax);

    if (visible) {
        outCommands[id].indexCount = e.indexCount;
        outCommands[id].instanceCount = e.instanceCount;
        outCommands[id].firstIndex = e.firstIndex;
        outCommands[id].baseVertex = e.baseVertex;
        outCommands[id].baseInstance = e.baseInstance;
    } else {
        outCommands[id].indexCount = e.indexCount;
        outCommands[id].instanceCount = 0u;
        outCommands[id].firstIndex = e.firstIndex;
        outCommands[id].baseVertex = e.baseVertex;
        outCommands[id].baseInstance = e.baseInstance;
    }
}
